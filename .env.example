# LinkedIn OAuth 2.0 Access Token (Requires 'w_member_social' and 'openid profile' scopes)
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# LinkedIn Member Sub ID (e.g., "urn:li:person:abcdef1234")
LINKEDIN_AUTHOR_URN=urn:li:person:your_member_id_here

# Port for the server (defaults to 3000 locally, provided automatically by Railway/Render/Heroku)
PORT=3000
